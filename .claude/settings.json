{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(fvm flutter analyze:*)",
      "Bash(fvm flutter test:*)",
      "Bash(fvm flutter pub get:*)",
      "Bash(fvm flutter devices:*)",
      "Bash(fvm flutter build apk:*)",
      "Bash(fvm flutter build ios --no-codesign:*)",
      "Bash(fvm dart format:*)",
      "Bash(fvm flutter --version)",
      "Bash(adb devices:*)",
      "Bash(adb logcat:*)",
      "Bash(adb shell getprop:*)",
      "Bash(adb shell dumpsys media.camera:*)",
      "Bash(adb shell dumpsys media.audio_flinger:*)",
      "Bash(ffprobe:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./android/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Edit(./android/key.properties)",
      "Bash(fvm use:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-fvm.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-dart.sh"
          }
        ]
      }
    ]
  }
}
